# Environment variables for Kubernetes Remediation Agent

# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Path to kubeconfig (leave empty to use in-cluster config)
# KUBECONFIG=/path/to/kubeconfig

# Optional: authenticated agent API and Grafana webhook integration
# REMEDIATION_API_TOKEN=replace_with_a_secret
# GRAFANA_WEBHOOK_SECRET=replace_with_a_secret

# Optional: Grafana administrator credentials for deploy/grafana/docker-compose.yml
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=replace_before_sharing
